{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webnative.local/ir/display_list.schema.json",
  "title": "webnative display list IR",
  "type": "object",
  "required": ["viewport", "ops"],
  "properties": {
    "viewport": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "ops": {
      "type": "array",
      "items": { "$ref": "#/$defs/op" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "op": {
      "oneOf": [
        { "$ref": "#/$defs/rect" },
        { "$ref": "#/$defs/text_run" }
      ]
    },
    "rect": {
      "type": "object",
      "required": ["type", "x", "y", "w", "h", "fill"],
      "properties": {
        "type": { "const": "rect" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "w": { "type": "number" },
        "h": { "type": "number" },
        "fill": {
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        }
      },
      "additionalProperties": false
    },
    "text_run": {
      "type": "object",
      "required": ["type", "x", "y", "color", "glyphs"],
      "properties": {
        "type": { "const": "text_run" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "color": { "type": "string" },
        "font_file": { "type": "string" },
        "glyphs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["gid", "x", "y", "w", "h", "u0", "v0", "u1", "v1", "adv"],
            "properties": {
              "gid": { "type": "integer" },
              "x": { "type": "number" },
              "y": { "type": "number" },
              "w": { "type": "number" },
              "h": { "type": "number" },
              "u0": { "type": "number" },
              "v0": { "type": "number" },
              "u1": { "type": "number" },
              "v1": { "type": "number" },
              "adv": { "type": "number" }
            }
          }
        }
      },
      "additionalProperties": true
    }
  }
}
